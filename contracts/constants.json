      "title": "Predict Output",
      "interaction": "choose_answer",
      "durationMs": 40000,
      "maxGradedSubmissions": 1,
      "optionCount": 4
    },
    {
      "index": 3,
      "type": "logic",
      "title": "Find Logical Error",
      "interaction": "choose_answer",
      "durationMs": 50000,
      "maxGradedSubmissions": 1,
      "optionCount": 4
    },
    {
      "index": 4,
      "type": "fix",
      "title": "Fix the Code",
      "interaction": "edit_code",
      "durationMs": 180000,
      "maxGradedSubmissions": 10,
      "maxSampleRuns": 30,
      "sampleRunCooldownMs": 5000
    }
  ],
  "countdownMs": 3000,
  "intermissionMs": 5000,
  "judgeGraceMs": 30000,
  "disconnect": {
    "clientHeartbeatMs": 5000,
    "serverTimeoutMs": 15000,
    "reconnectGraceMs": 30000
  },
  "voidIfNoSubmissionWithinMs": 15000,
  "scoring": {
    "roundMax": 100,
    "speedWeight": 0.7,
    "speedFloor": 30,
    "wrongAttemptPenalty": 10,
    "minimumCorrectScore": 1
  },
  "elo": {
    "start": 1200,
    "floor": 100,
    "kProvisional": 40,
    "provisionalMatches": 10,
    "kNormal": 20,
    "kHigh": 10,
    "highRatingAt": 2000,
    "scale": 400
  },
  "ratedDifficultyCaps": [
    { "minRating": 1600, "blockedDifficulties": ["easy"] },
    { "minRating": 2000, "blockedDifficulties": ["easy", "medium"] }
  ],
  "matchmaking": {
    "tickMs": 1000,
    "windows": [
      { "afterMs": 0, "ratingDelta": 100 },
      { "afterMs": 10000, "ratingDelta": 200 },
      { "afterMs": 25000, "ratingDelta": 350 },
      { "afterMs": 45000, "ratingDelta": 600 },
      { "afterMs": 90000, "ratingDelta": null }
    ],
    "samePairRatedCap": 3,
    "samePairWindowHours": 24,
    "avoidRecentProblems": 20
  },
  "lobby": {
    "codeLength": 6,
    "codeAlphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "ttlMs": 1800000,
    "rated": false
  },
  "limits": {
    "sourceBytes": 65536,
    "stdoutBytes": 262144,
    "stderrBytes": 8192,
    "compileTimeoutMs": 10000,
    "compileMemoryKb": 262144,
