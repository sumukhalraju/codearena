{
  "product": "CodeArena",
  "matchFormat": "four-round-battle",
  "languages": [
    {
      "id": "c",
      "label": "C",
      "sourceFile": "main.c",
      "compile": "gcc -O2 -std=c11 -pipe -static-libgcc -o /tmp/main /work/main.c",
      "run": "/tmp/main"
    },
    {
      "id": "cpp",
      "label": "C++",
      "sourceFile": "main.cpp",
      "compile": "g++ -O2 -std=c++17 -pipe -o /tmp/main /work/main.cpp",
      "run": "/tmp/main"
    },
    {
      "id": "python",
      "label": "Python",
      "sourceFile": "main.py",
      "compile": null,
      "run": "python3 -I /work/main.py"
    },
    {
      "id": "javascript",
      "label": "JavaScript",
      "sourceFile": "main.js",
      "compile": null,
      "run": "node --no-warnings /work/main.js"
    }
  ],
  "difficulties": ["easy", "medium", "hard"],
  "rounds": [
    {
      "index": 1,
      "type": "syntax",
      "title": "Find Syntax Error",
      "interaction": "edit_code",
      "durationMs": 90000,
      "maxGradedSubmissions": 6,
      "maxSampleRuns": 20,
      "sampleRunCooldownMs": 5000
    },
    {
      "index": 2,
