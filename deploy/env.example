# Copy to backend/.env for local development.
# Production uses a mode-0600 file on the VPS. Do not commit a filled copy.

NODE_ENV=development
PORT=4000
WORKER_PORT=4001

DATABASE_URL=postgresql://codearena:codearena@localhost:5432/codearena
REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# 32+ random bytes in production. This development value is obvious on purpose.
JWT_ACCESS_SECRET=dev-only-change-me-to-32-bytes-minimum
JWT_ACCESS_SECRET_PREVIOUS=

REQUIRE_EMAIL_VERIFICATION=false
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CodeArena <noreply@example.com>

# Used only by pnpm admin:bootstrap when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Must stay false outside a local debugging session.
LOG_SUBMISSION_SOURCE=false

# Optional. The app must run if MinIO is absent.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=codearena
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
